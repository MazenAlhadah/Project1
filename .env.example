# =============================================
# قاعدة البيانات PostgreSQL
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=engadmin
DB_PASSWORD=your_strong_password_here
DB_NAME=engineering_platform

# =============================================
# JWT Authentication
# =============================================
JWT_ACCESS_SECRET=your_very_long_random_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================
# Cloudinary (رفع الصور والملفات)
# =============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================
# Gmail SMTP (إرسال الإيميلات)
# =============================================
GMAIL_USER=your_gmail@gmail.com
# كلمة سر التطبيق (App Password) من إعدادات Google
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM_NAME=منصة معادلات الهندسة

# =============================================
# الخادم
# =============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================
# إعدادات التطبيق
# =============================================
WHATSAPP_NUMBER=201234567890
SUPPORT_PHONE=01234567890
SUPPORT_EMAIL=support@yourdomain.com
PLATFORM_NAME=منصة معادلات الهندسة

# =============================================
# Frontend (Next.js)
# =============================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_PLATFORM_NAME=منصة معادلات الهندسة
